# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit your real .env file.

# PostgreSQL connection string.
# Local example (adjust user/password/db name to match your setup):
DATABASE_URL=postgresql+psycopg2://worship:worship@localhost:5432/worship_setlist

# Used later for auth/session signing. Set this to a long random string.
SECRET_KEY=change-me-to-a-random-string

# Comma-separated allowed origins, or "*" for any (fine for single-origin
# deployments where the frontend is served by this same app).
CORS_ORIGINS=*

# Dev convenience only - set to true to auto-create tables from models
# instead of running Alembic migrations. Leave false/unset in production.
AUTO_CREATE_TABLES=false

ENVIRONMENT=development
